{
  "name": "aqueduct-pdm-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify-queue.ts --bundle --platform=node --format=esm --target=node20 --log-level=warning | node --input-type=module",
    "verify:detail": "esbuild scripts/verify-detail.ts --bundle --platform=node --format=esm --target=node20 --log-level=warning | node --input-type=module"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
