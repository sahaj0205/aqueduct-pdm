# Copy to .env before running `make db-up`:
#     cp .env.example .env
# .env is gitignored and is never committed. These are local development
# credentials for a container bound to localhost — not secrets.

# Superuser role created on first container start. Owns the database and is
# what scripts/schema.sql is applied as.
POSTGRES_USER=aqueduct
POSTGRES_PASSWORD=aqueduct_local_dev
POSTGRES_DB=aqueduct

# Host port the container publishes on. Change if 5432 is already taken by a
# postgres installed directly on your machine.
POSTGRES_PORT=5432

# How Python connects. Must agree with the four values above.
DATABASE_URL=postgresql+psycopg://aqueduct:aqueduct_local_dev@localhost:5432/aqueduct
